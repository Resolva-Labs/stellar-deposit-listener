# Horizon endpoint (use https://horizon-testnet.stellar.org for testnet)
HORIZON_URL=https://horizon.stellar.org

# Supabase project URL and SERVICE ROLE key.
# The service role key bypasses RLS and must NEVER be exposed to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override the static 10-wallet pool at runtime (comma-separated).
# Leave unset to use the defaults compiled into stellar-stream.service.ts.
# PLATFORM_WALLETS=GABC...,GDEF...,GHIJ...

# HTTP port for the Nest application (health endpoint lives here).
PORT=3001
